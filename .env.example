# Copie para .env e preencha. Estes valores são PÚBLICOS (vão para o app); a segurança vem do RLS no banco.
# Sem Supabase configurado, o app funciona em modo local (dados só no aparelho).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-ou-publishable-key
# URL do site publicado (links de confirmação de e-mail abrem aqui)
VITE_SITE_URL=https://SEU-USUARIO.github.io/brotar/

# AdMob (deixe vazio para usar os IDs de TESTE do Google)
VITE_ADMOB_BANNER_ID=
VITE_ADMOB_REWARDED_ID=
VITE_ADMOB_TESTING=true
# ID do app AdMob (formato ca-app-pub-XXXX~YYYY) — usado no build Android: export ADMOB_APP_ID=...
